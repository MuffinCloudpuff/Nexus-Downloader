{
  "manifest_version": 3,
  "name": "Nexus Downloader",
  "description": "Manage Nexus Downloader tasks and download browser media with the desktop app.",
  "version": "1.4.0",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "cookies",
    "declarativeNetRequest",
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* wss://127.0.0.1:* wss://localhost:*;"
  },
  "action": {
    "default_title": "Nexus Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon24.png",
      "24": "icon24.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "64": "icon64.png",
      "128": "icon128.png",
      "256": "icon256.png"
    }
  },
  "icons": {
    "16": "icon24.png",
    "24": "icon24.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "64": "icon64.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["catch-script/mse-attribution.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["cat-catch-content-script.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["catch-script/overlay-media-state.js", "catch-script/media-download-overlay.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon48.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
